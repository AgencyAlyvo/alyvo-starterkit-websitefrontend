{
  "name": "@alyvo/website-frontend-nomdusiteduclient",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:run:dev:ssr": "cross-env NUXT_SSR=true nuxi dev src-nuxt --dotenv .env.development --no-clear --clipboard --port=1470 --open",
    "web:run:dev:spa": "cross-env NUXT_SSR=false nuxi dev src-nuxt --dotenv .env.development --no-clear --clipboard --port=1470 --open",
    "web:run:staging:ssr": "cross-env NUXT_SSR=true nuxi dev src-nuxt --dotenv .env.staging --no-clear --clipboard --port=1470 --open",
    "web:run:staging:spa": "cross-env NUXT_SSR=false nuxi dev src-nuxt --dotenv .env.staging --no-clear --clipboard --port=1470 --open",
    "web:run:prod:ssr": "cross-env NUXT_SSR=true nuxi dev src-nuxt --dotenv .env.production --no-clear --clipboard --port=1470 --open",
    "web:run:prod:spa": "cross-env NUXT_SSR=false nuxi dev src-nuxt --dotenv .env.production --no-clear --clipboard --port=1470 --open",
    "web:run:dev:docker:ssr": "cross-env ENV_MODE=dev-ssr docker compose up",
    "web:run:dev:docker:spa": "cross-env ENV_MODE=dev-spa docker compose up",
    "web:run:staging:docker:ssr": "cross-env ENV_MODE=staging-ssr docker compose up",
    "web:run:staging:docker:spa": "cross-env ENV_MODE=staging-spa docker compose up",
    "web:run:prod:docker:ssr": "cross-env ENV_MODE=prod-ssr docker compose up",
    "web:run:prod:docker:spa": "cross-env ENV_MODE=prod-spa docker compose up",
    "web:build:static:dev": "cross-env NUXT_SSR=false nuxi generate src-nuxt --dotenv .env.development",
    "web:build:static:staging": "cross-env NUXT_SSR=false nuxi generate src-nuxt --dotenv .env.staging",
    "web:build:static:prod": "cross-env NUXT_SSR=false nuxi generate src-nuxt --dotenv .env.production",
    "web:build:static:dev:ssr": "cross-env NUXT_SSR=true nuxi generate src-nuxt --dotenv .env.development",
    "web:build:static:staging:ssr": "cross-env NUXT_SSR=true nuxi generate src-nuxt --dotenv .env.staging",
    "web:build:static:prod:ssr": "cross-env NUXT_SSR=true nuxi generate src-nuxt --dotenv .env.production",
    "web:build:server:dev": "cross-env NUXT_SSR=false nuxi build src-nuxt --dotenv .env.development",
    "web:build:server:staging": "cross-env NUXT_SSR=false nuxi build src-nuxt --dotenv .env.staging",
    "web:build:server:prod": "cross-env NUXT_SSR=false nuxi build src-nuxt --dotenv .env.production",
    "web:build:server:dev:ssr": "cross-env NUXT_SSR=true nuxi build src-nuxt --dotenv .env.development",
    "web:build:server:staging:ssr": "cross-env NUXT_SSR=true nuxi build src-nuxt --dotenv .env.staging",
    "web:build:server:prod:ssr": "cross-env NUXT_SSR=true nuxi build src-nuxt --dotenv .env.production",
    "web:preview:dev": "cross-env PORT=1461 nuxi preview src-nuxt --dotenv .env.development",
    "web:preview:staging": "cross-env PORT=1461 nuxi preview src-nuxt --dotenv .env.staging",
    "web:preview:prod": "cross-env PORT=1461 nuxi preview src-nuxt --dotenv .env.production",
    "web:analyze": "nuxi analyze src-nuxt --loglevel verbose",
    "web:cleanup": "nuxi cleanup src-nuxt",
    "web:prepare": "nuxi prepare src-nuxt",
    "test:unit:dev": "vitest run --mode development",
    "test:unit:dev:watch": "vitest watch --mode development",
    "test:unit:dev:gui": "vitest --ui --mode development",
    "test:unit:staging": "vitest run --mode staging --coverage",
    "test:unit:prod": "vitest run --mode production --coverage",
    "test:e2e:dev:chrome": "npm run web:build:static:dev && npm-run-all2 --parallel web:preview:dev cypress-run-chrome",
    "test:e2e:dev:firefox": "npm run web:build:static:dev && npm-run-all2 --parallel web:preview:dev cypress-run-firefox",
    "test:e2e:dev:edge": "npm run web:build:static:dev && npm-run-all2 --parallel web:preview:dev cypress-run-edge",
    "test:e2e:staging:chrome": "npm run web:build:static:staging && npm-run-all2 --parallel web:preview:staging cypress-run-chrome",
    "test:e2e:staging:firefox": "npm run web:build:static:staging && npm-run-all2 --parallel web:preview:staging cypress-run-firefox",
    "test:e2e:staging:edge": "npm run web:build:static:staging && npm-run-all2 --parallel web:preview:staging cypress-run-edge",
    "test:e2e:prod:chrome": "npm run web:build:static:prod && npm-run-all2 --parallel web:preview:prod cypress-run-chrome",
    "test:e2e:prod:firefox": "npm run web:build:static:prod && npm-run-all2 --parallel web:preview:prod cypress-run-firefox",
    "test:e2e:prod:edge": "npm run web:build:static:prod && npm-run-all2 --parallel web:preview:prod cypress-run-edge",
    "test:e2e:dev:gui:chrome": "npm run web:build:static:dev && npm-run-all2 --parallel web:preview:dev cypress-open-chrome",
    "test:e2e:dev:gui:firefox": "npm run web:build:static:dev && npm-run-all2 --parallel web:preview:dev cypress-open-firefox",
    "test:e2e:dev:gui:edge": "npm run web:build:static:dev && npm-run-all2 --parallel web:preview:dev cypress-open-edge",
    "test:e2e:staging:gui:chrome": "npm run web:build:static:staging && npm-run-all2 --parallel web:preview:staging cypress-open-chrome",
    "test:e2e:staging:gui:firefox": "npm run web:build:static:staging && npm-run-all2 --parallel web:preview:staging cypress-open-firefox",
    "test:e2e:staging:gui:edge": "npm run web:build:static:staging && npm-run-all2 --parallel web:preview:staging cypress-open-edge",
    "test:e2e:prod:gui:chrome": "npm run web:build:static:prod && npm-run-all2 --parallel web:preview:prod cypress-open-chrome",
    "test:e2e:prod:gui:firefox": "npm run web:build:static:prod && npm-run-all2 --parallel web:preview:prod cypress-open-firefox",
    "test:e2e:prod:gui:edge": "npm run web:build:static:prod && npm-run-all2 --parallel web:preview:prod cypress-open-edge",
    "cypress-open-chrome": "cypress open --browser chrome --e2e --config-file cypress.config.ts",
    "cypress-open-firefox": "cypress open --browser firefox --e2e --config-file cypress.config.ts",
    "cypress-open-edge": "cypress open --browser edge --e2e --config-file cypress.config.ts",
    "cypress-run-chrome": "cypress run --browser chrome --e2e --config-file cypress.config.ts",
    "cypress-run-firefox": "cypress run --browser firefox --e2e --config-file cypress.config.ts",
    "cypress-run-edge": "cypress run --browser edge --e2e --config-file cypress.config.ts",
    "lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:ts",
    "lint:prettier": "prettier --check .",
    "lint:ts": "nuxi typecheck src-nuxt --dotenv .env.development",
    "lint:eslint": "eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "prepare": "husky && nuxi prepare src-nuxt --dotenv .env.development"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "luxon": "^3.7.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/devtools": "^3.4.2",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/robots": "^6.2.0",
    "@nuxtjs/seo": "^5.3.14",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.5",
    "@types/mochawesome": "^6.2.5",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "cross-env": "^10.1.0",
    "cypress": "^16.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-jsdoc": "^64.3.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "mochawesome": "^8.0.1",
    "npm-check-updates": "^23.1.0",
    "npm-run-all2": "^9.0.3",
    "nuxt": "4.5.2",
    "nuxt-seo-utils": "^8.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "allowScripts": {
    "cypress": true,
    "unrs-resolver": true,
    "esbuild": true,
    "sharp": true,
    "fsevents": true
  }
}
